# SKILLTRACE Environment Variables
PROJECT_NAME="SKILLTRACE"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Default: SQLite for instant hackathon setup)
# For PostgreSQL use: postgresql://username:password@localhost:5432/skilltrace_db
DATABASE_URL="sqlite:///./skilltrace.db"

# AI Matching Configuration
ENABLE_SEMANTIC_MATCHING=false
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# CORS Configuration
CORS_ORIGINS="*"
